# Copy this file to .env.local and fill in your key.
# The key is read only on the server (API routes) — it is never shipped to the browser.

OPENAI_API_KEY=sk-your-openai-key-here

# Models (override if your account has different access).
# A fast/cheap model is used for chat; a stronger model for analysis.
OPENAI_MODEL=gpt-4o-mini
OPENAI_ANALYSIS_MODEL=gpt-4o

# Sarvam AI — Indian-language voice layer (speech-to-text + text-to-speech).
# Optional: voice features are disabled gracefully if this is unset.
SARVAM_API_KEY=your-sarvam-key-here
# bulbul:v2 speakers: anushka, abhilash, manisha, vidya, arya, karun, hitesh
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_SPEAKER=anushka

# Supabase — accounts + cloud sync (optional; app runs in on-device guest mode
# if unset). These are PUBLIC values (safe in the browser); Row-Level Security
# protects the data. From Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
